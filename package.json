{
  "name": "scholar-hub",
  "version": "1.0.0",
  "description": "ScholarHub Full-Stack Application",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node backend/scripts/setup.js",
    "start": "node backend/scripts/start.js",
    "dev": "node backend/scripts/start.js",
    "setup": "node backend/scripts/setup.js",
    "backend": "mvnw.cmd spring-boot:run -pl backend",
    "frontend": "npm run dev --prefix frontend",
    "postinstall": "npm install --prefix frontend",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "node backend/scripts/setup.js"
  }
}
